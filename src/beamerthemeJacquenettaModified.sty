% ----------------------------------------------------------
% beamerthemeJacquenettaModified.sty — Main theme loader
%
%
% 2026 Samuel Manchajm — CC BY-SA 4.0
%
% Usage:
%   \documentclass[aspectratio=169]{beamer}
%   \usetheme{JacquenettaModified}
%
% Options:
%   accent=<color>   Change the accent color (default: jq@blue)
%                    e.g. accent=jq@orange, accent=teal
%   noborder         Disable the signature dark border
%
% Dependencies: tikz, tcolorbox, helvet, microtype, setspace
% ----------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeJacquenettaModified}%
  [2026/04/06 v1.0 JacquenettaModified Beamer theme]

\mode<presentation>

% === Pass options to sub-themes ================================
\DeclareOptionBeamer{accent}{%
  \PassOptionsToPackage{accent=#1}{beamercolorthemeJacquenettaModified}}
\DeclareOptionBeamer{noborder}{%
  \PassOptionsToPackage{noborder}{beamerouterthemeJacquenettaModified}}
\ProcessOptionsBeamer

% === Required packages =========================================
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}
% \RequirePackage{microtype}

% === Load sub-themes ===========================================
\usecolortheme{JacquenettaModified}
\usefonttheme{JacquenettaModified}
\useinnertheme{JacquenettaModified}
\useoutertheme{JacquenettaModified}

\mode<all>
\endinput
