% ----------------------------------------------------------
% beamerfontthemeJacquenettaModified.sty — URW Classico
% Successfully installed and working with pdflatex!
% ----------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeJacquenettaModified}%
  [2026/04/06 v1.0 JacquenettaModified font theme]

\mode<presentation>

% === Font packages =============================================

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{anyfontsize}
\RequirePackage{setspace}
\RequirePackage{textcomp}
\RequirePackage{xcolor}

% === URW Classico ==============================================

% Use URWClassico directly
\renewcommand{\sfdefault}{URWClassico}
\renewcommand{\familydefault}{\sfdefault}

% Make text visible (black)
\color{black}

% === Mathematics ===============================================

\RequirePackage{amsmath,amssymb}

% === Remove ALL bold from fonts ================================

\setbeamerfont{title}{size=\fontsize{20}{24}\selectfont, series=\mdseries}
\setbeamerfont{subtitle}{size=\fontsize{12}{16}\selectfont, series=\mdseries}
\setbeamerfont{frametitle}{size=\fontsize{18}{22}\selectfont, series=\mdseries}
\setbeamerfont{author}{size=\fontsize{11}{14}\selectfont, series=\mdseries}
\setbeamerfont{institute}{size=\fontsize{9}{11}\selectfont, series=\mdseries}
\setbeamerfont{date}{size=\fontsize{9}{11}\selectfont, series=\mdseries}
\setbeamerfont{page number in head/foot}{size=\fontsize{7}{9}\selectfont, series=\mdseries}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{10}{13}\selectfont, series=\mdseries}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9}{12}\selectfont, series=\mdseries}
\setbeamerfont{footnote}{size=\fontsize{7}{9}\selectfont, series=\mdseries}
\setbeamerfont{section in toc}{size=\normalsize, series=\mdseries}
\setbeamerfont{subsection in toc}{size=\small, series=\mdseries}
\setbeamerfont{block title}{size=\normalsize, series=\mdseries}
\setbeamerfont{block body}{size=\normalsize, series=\mdseries}
\setbeamerfont{description item}{series=\mdseries}
\setbeamerfont{caption}{size=\footnotesize, series=\mdseries}
\setbeamerfont{framesubtitle}{size=\normalsize, series=\mdseries}

% === Disable microtype expansion ===============================

\RequirePackage{microtype}
\microtypesetup{expansion=false}
\microtypesetup{tracking=false}
\SetTracking{encoding=*, shape=*}{0}

% === Normal line spacing =======================================

\setstretch{1}

% === Override \textbf to prevent bold ==========================

\let\origtextbf\textbf
\renewcommand\textbf[1]{\origtextbf{\mdseries #1}}

% === Completely disable bold ===================================

\renewcommand{\bfseries}{}
\renewcommand{\bf}{}

\mode<all>
\endinput